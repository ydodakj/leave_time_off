<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Button "Kirim ke Discord" di header form leave -->
    <record id="view_hr_leave_form_ydod_discord" model="ir.ui.view">
        <field name="name">hr.leave.form.ydod.discord</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state'][last()]" position="before">
                <button string="Kirim ke Discord"
                        name="action_send_discord_manual"
                        type="object"
                        invisible="not id"
                        icon="fa-discord"
                        title="Kirim notifikasi ke Discord sesuai state saat ini"/>
            </xpath>
        </field>
    </record>

    <!-- Juga inject ke form manager -->
    <record id="view_hr_leave_form_manager_ydod_discord" model="ir.ui.view">
        <field name="name">hr.leave.form.manager.ydod.discord</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state'][last()]" position="before">
                <button string="Kirim ke Discord"
                        name="action_send_discord_manual"
                        type="object"
                        invisible="not id"
                        title="Kirim notifikasi ke Discord sesuai state saat ini"/>
            </xpath>
        </field>
    </record>

</odoo>
