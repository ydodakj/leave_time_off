<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Discord User ID tab to employee form -->
    <record id="view_employee_form_ydod_discord" model="ir.ui.view">
        <field name="name">hr.employee.form.ydod.discord</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Discord" name="ydod_discord_page">
                    <group string="Discord Integration">
                        <field name="ydod_discord_user_id"
                               placeholder="e.g. 123456789012345678"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
