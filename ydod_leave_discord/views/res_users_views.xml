<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_discord_leave" model="ir.ui.view">
        <field name="name">res.users.form.discord.leave</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Discord" name="discord_leave">
                    <group>
                        <field name="discord_user_id"
                               placeholder="Contoh: 123456789012345678"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
